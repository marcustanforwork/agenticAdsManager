{
  "name": "ads-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-boundaries.ts && depcruise --config .dependency-cruiser.cjs packages apps && ADS_LINT_BOUNDARIES_ONLY=1 eslint packages apps",
    "test": "vitest run",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
